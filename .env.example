# Copy to .env.local and fill in. For local dev, run `supabase start` and use
# `supabase status -o env` to read the local URL + keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local: http://127.0.0.1:54321  ·  Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Service role bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Stripe (Payments + Invoicing; gate behind the flag) ───────────────────────
# Set STRIPE_ENABLED=true AND add a secret key to turn payments on. No rebuild.
# Wires self-serve Checkout, admin-issued hosted invoices, and the webhook.
# Use TEST keys (sk_test/pk_test + a test webhook secret from `stripe listen`)
# to verify locally; swap to LIVE keys (sk_live/pk_live + the live endpoint's
# whsec) only in gitignored .env.local / Vercel env — NEVER commit a secret key.
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Without a key, transactional email no-ops and logs to the console.
RESEND_API_KEY=""
EMAIL_FROM="Gun License NYC <onboarding@resend.dev>"

# ── DMV-01 fallback recipients (the "email my request" draft) ─────────────────
# TO = NY State ITS help desk (the owner of the NY.gov ID / MyDMV OIDC login
# error) — NOT the DMV, which takes no records requests by email. CC = our
# concierge inbox so our team always has a copy and can help.
NEXT_PUBLIC_DMV_REQUEST_TO="Fixit@its.ny.gov"
NEXT_PUBLIC_DMV_REQUEST_CC="gunlicensenyc@gmail.com"

# ── SMS (Twilio, optional) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Google Calendar (optional two-way sync; gate behind the flag) ─────────────
# Bookings always email a native .ics invite (zero cost). This OAuth sync is an
# Google Calendar two-way sync was removed (V3-P4.6) — native .ics invites
# are the calendar path and need no keys.
# turn it on; with the flag off the app runs fully without these. Free Google
# Calendar API — no recurring cost.

# Cron protection (Vercel Cron sends this as a Bearer token)
CRON_SECRET=""

# ── SEO: search-engine verification (optional; meta-tag path) ─────────────────
# Set these to have the verification <meta> tags emitted site-wide. DNS or an
# HTML-file upload also works; leave blank if you verify that way.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ── SEO: review ASK link (optional; the ask, never fabricated proof) ──────────
# A Google Business Profile "write a review" short link. When set, the
# license-issued email and the portal license screen invite the newly-licensed
# client to leave a review. Silent until set. We never display ratings or emit
# AggregateRating schema.
NEXT_PUBLIC_REVIEW_URL=""

# ── SEO: owned profiles for the Organization sameAs graph (optional) ──────────
# Only set a URL once the profile is LIVE and you control it — a fake URL poisons
# the entity. A Google Business Profile is highest-value (also unlocks the local
# pack). Each set var appears in the site-wide Organization JSON-LD sameAs.
NEXT_PUBLIC_GBP_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
