# Copy to .env.local and fill in. For local dev, run `supabase start` and use
# `supabase status -o env` to read the local URL + keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Local: http://127.0.0.1:54321  ·  Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Service role bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supervised editorial automation ─────────────────────────────────────────
# Vercel AI Gateway uses the deployment's automatic OIDC token. For local work,
# run `vercel env pull` or set AI_GATEWAY_API_KEY in a gitignored .env.local.
# The cron creates private drafts only; human fact/legal review still gates every
# publication. Set BLOG_AI_ENABLED=false only as an emergency drafting kill switch.
AI_GATEWAY_MODEL="openai/gpt-5.4-mini"
AI_GATEWAY_API_KEY=""
BLOG_AI_ENABLED="true"
EDITORIAL_MAX_PENDING_DRAFTS="6"

# Separate, higher-risk disclosure assistant. Keep off unless counsel approves.
AI_ENABLED="false"
ANTHROPIC_API_KEY=""

# ── Firearm License NYC application brand (launches fail-closed) ─────────────
# Keep both flags false until counsel approves the legal pages and the Resend
# sender, Stripe descriptor prefix and end-to-end launch checks are complete.
FL_BRAND_ENABLED="false"
NEXT_PUBLIC_FL_BRAND_ENABLED="false"
FL_APP_ORIGIN="https://app.firearmlicensenyc.com"
FL_MARKETING_ORIGIN="https://firearmlicensenyc.com"
FL_SUPPORT_EMAIL="gunlicensenyc@gmail.com"
FL_LEGAL_NAME="Gun License NYC LLC"
GLN_LEGAL_NAME="Gun License NYC LLC"
# Stripe-approved account prefix. GUNLICNYC* APPLICATION = 22 characters.
STRIPE_ACCOUNT_DESCRIPTOR_PREFIX="GUNLICNYC"
FL_STRIPE_DESCRIPTOR_SUFFIX="APPLICATION"
# credit_paid credits the amount actually paid for Self-Guided; none gives no credit.
FL_UPGRADE_CREDIT_MODE="credit_paid"

# ── Stripe (Payments + Invoicing; gate behind the flag) ───────────────────────
# Set STRIPE_ENABLED=true AND add a secret key to turn payments on. No rebuild.
# Wires self-serve Checkout, admin-issued hosted invoices, and the webhook.
# Use TEST keys (sk_test/pk_test + a test webhook secret from `stripe listen`)
# to verify locally; swap to LIVE keys (sk_live/pk_live + the live endpoint's
# whsec) only in gitignored .env.local / Vercel env — NEVER commit a secret key.
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Server-only comp and fixed-price discount codes. Keep plaintext values in
# Vercel Secrets / .env.local only; never use a NEXT_PUBLIC_ prefix.
ACCESS_CODES=""
DISCOUNT_CODES=""
DISCOUNT_CODES_EXTRA=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Without a key, transactional email no-ops and logs to the console.
RESEND_API_KEY=""
EMAIL_FROM="Gun License NYC <onboarding@resend.dev>"
# The support/reply-to inbox may be Gmail. Automated From addresses still need
# a verified firearmlicensenyc.com sending domain before live email is enabled.
EMAIL_FROM_FL=""

# ── DMV-01 fallback recipients (the "email my request" draft) ─────────────────
# TO = NY State ITS help desk (the owner of the NY.gov ID / MyDMV OIDC login
# error) — NOT the DMV, which takes no records requests by email. CC = our
# concierge inbox so our team always has a copy and can help.
NEXT_PUBLIC_DMV_REQUEST_TO="Fixit@its.ny.gov"
NEXT_PUBLIC_DMV_REQUEST_CC="gunlicensenyc@gmail.com"

# ── SMS (Twilio, optional) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Google Calendar (optional two-way sync; gate behind the flag) ─────────────
# Bookings always email a native .ics invite (zero cost). This OAuth sync is an
# Google Calendar two-way sync was removed (V3-P4.6) — native .ics invites
# are the calendar path and need no keys.
# turn it on; with the flag off the app runs fully without these. Free Google
# Calendar API — no recurring cost.

# Cron protection (Vercel Cron sends this as a Bearer token)
CRON_SECRET=""

# ── SEO: search-engine verification (optional; meta-tag path) ─────────────────
# Set these to have the verification <meta> tags emitted site-wide. DNS or an
# HTML-file upload also works; leave blank if you verify that way.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ── SEO: public Spanish surface (/es), flag-gated so it ships dark ────────────
# Set to "true" to turn on the URL-prefixed Spanish money pages (/es, /es/cost,
# /es/requirements, /es/timeline, /es/how-it-works), their hreflang alternates,
# and the footer language toggle. With it unset/false, those routes 404, no
# hreflang is emitted, and the toggle is hidden — so the surface can wait for a
# native-fluent legal review without touching the live English site. There is NO
# Accept-Language auto-redirect; the toggle is the only entry point.
NEXT_PUBLIC_I18N_ES="false"

# ── SEO: review ASK link (optional; the ask, never fabricated proof) ──────────
# A Google Business Profile "write a review" short link. When set, the
# license-issued email and the portal license screen invite the newly-licensed
# client to leave a review. Silent until set. We never display ratings or emit
# AggregateRating schema.
NEXT_PUBLIC_REVIEW_URL=""

# ── SEO: owned profiles for the Organization sameAs graph (optional) ──────────
# Only set a URL once the profile is LIVE and you control it — a fake URL poisons
# the entity. A Google Business Profile is highest-value (also unlocks the local
# pack). Each set var appears in the site-wide Organization JSON-LD sameAs.
NEXT_PUBLIC_GBP_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
